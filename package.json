{
  "name": "prints",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "brand": "node scripts/build-brand.mjs",
    "dev": "vite",
    "build": "node scripts/check-brand.mjs && npm run test && npm run typecheck && vite build && node scripts/build-sw.mjs && node scripts/check-dist.mjs && node scripts/smoke-ui.mjs && node scripts/smoke-sw.mjs",
