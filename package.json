    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/core/*.test.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.59.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "fake-indexeddb": "^6.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
